# Bhoomi Mithra — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── Backend API ─────────────────────────────────────────────────────────────
# URL of the Cloudflare Worker backend (local dev)
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# ─── Site Metadata ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI Configuration ────────────────────────────────────────────────────────
# Gemini API Key — used by the Cloudflare Worker (set via `wrangler secret put GEMINI_API_KEY`)
# For local worker dev, copy this into worker/.dev.vars as: GEMINI_API_KEY=your-key
GEMINI_API_KEY=your-gemini-api-key-here
